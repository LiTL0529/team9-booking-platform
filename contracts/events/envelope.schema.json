{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventEnvelope",
  "description": "Envelope shared by every event on the bus.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "event_type": {
      "enum": [
        "MerchantOnboarded",
        "SlotPublished",
        "BookingConfirmed",
        "BookingCancelled"
      ]
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "trace": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "trace",
    "data"
  ],
  "additionalProperties": false
}
