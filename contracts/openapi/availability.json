{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MerchantSummary": {
        "properties": {
          "merchant_id": {
            "format": "uuid",
            "title": "Merchant Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "merchant_id",
          "name",
          "slug"
        ],
        "title": "MerchantSummary",
        "type": "object"
      },
      "SlotSearchResult": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "slots": {
            "items": {
              "$ref": "#/components/schemas/SlotSummary"
            },
            "title": "Slots",
            "type": "array"
          }
        },
        "required": [
          "date",
          "count",
          "offset",
          "has_more",
          "slots"
        ],
        "title": "SlotSearchResult",
        "type": "object"
      },
      "SlotSummary": {
        "properties": {
          "end_time": {
            "format": "date-time",
