  "info": {
    "description": "Slot search across merchants from an event-built read model with a cache.",
    "title": "Availability Service",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/availability/merchants": {
      "get": {
        "operationId": "list_merchants_v1_availability_merchants_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MerchantSummary"
                  },
                  "title": "Response List Merchants V1 Availability Merchants Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Participating merchants",
        "tags": [
          "availability"
        ]
      }
    },
    "/v1/availability/resource-types": {
      "get": {
        "operationId": "list_resource_types_v1_availability_resource_types_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Response List Resource Types V1 Availability Resource Types Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Resource types that have slots",
        "tags": [
          "availability"
        ]
      }
    },
    "/v1/availability/slots": {
      "get": {
        "operationId": "search_slots_v1_availability_slots_get",
        "parameters": [
          {
            "description": "Local date of the slots",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "description": "Local date of the slots",
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "merchant_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Merchant Id"
            }
          },
          {
            "in": "query",
            "name": "resource_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 50,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Resource Type"
            }
          },
          {
            "in": "query",
            "name": "include_booked",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Booked",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 100000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotSearchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search slots across all merchants",
        "tags": [
          "availability"
        ]
      }
    }
  }
}
