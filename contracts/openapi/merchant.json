{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MemberAssign": {
        "properties": {
          "role": {
            "default": "merchant_staff",
            "enum": [
              "merchant_admin",
              "merchant_staff"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._@+-]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "MemberAssign",
        "type": "object"
      },
      "MemberOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "membership_id": {
            "format": "uuid",
            "title": "Membership Id",
            "type": "string"
          },
          "merchant_id": {
            "format": "uuid",
            "title": "Merchant Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "sync_status": {
            "title": "Sync Status",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "membership_id",
          "merchant_id",
          "username",
          "role",
          "sync_status",
          "created_at"
        ],
        "title": "MemberOut",
        "type": "object"
      },
      "MerchantCreate": {
        "properties": {
          "contact_email": {
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Contact Email",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "maxLength": 80,
            "minLength": 2,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug",
          "contact_email"
        ],
        "title": "MerchantCreate",
        "type": "object"
      },
      "MerchantOut": {
        "properties": {
          "contact_email": {
            "title": "Contact Email",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "merchant_id": {
            "format": "uuid",
            "title": "Merchant Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "merchant_id",
          "name",
          "slug",
          "contact_email",
          "status",
          "created_at"
        ],
        "title": "MerchantOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Merchant onboarding, merchant users and roles.",
    "title": "Merchant Service",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/merchants": {
      "get": {
        "operationId": "list_merchants_v1_merchants_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MerchantOut"
                  },
                  "title": "Response List Merchants V1 Merchants Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List merchants visible to the caller",
        "tags": [
          "merchants"
        ]
      },
      "post": {
        "operationId": "onboard_merchant_v1_merchants_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MerchantCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MerchantOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Onboard a merchant",
        "tags": [
          "merchants"
        ]
      }
    },
    "/v1/merchants/me": {
      "get": {
        "operationId": "my_merchant_v1_merchants_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MerchantOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "The merchant the caller belongs to",
        "tags": [
          "merchants"
        ]
      }
    },
    "/v1/merchants/{merchant_id}": {
      "get": {
        "operationId": "get_merchant_v1_merchants__merchant_id__get",
