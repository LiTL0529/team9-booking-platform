                "schema": {
                  "$ref": "#/components/schemas/MerchantOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Merchant",
        "tags": [
          "merchants"
        ]
      }
    },
    "/v1/merchants/{merchant_id}/members": {
      "get": {
        "operationId": "list_members_v1_merchants__merchant_id__members_get",
        "parameters": [
          {
            "in": "path",
            "name": "merchant_id",
            "required": true,
