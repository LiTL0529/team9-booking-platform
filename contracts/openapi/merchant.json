        ]
      },
      "post": {
        "operationId": "assign_member_v1_merchants__merchant_id__members_post",
        "parameters": [
          {
            "in": "path",
            "name": "merchant_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Merchant Id",
