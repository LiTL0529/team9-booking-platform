{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PublishResult": {
        "properties": {
          "created": {
            "title": "Created",
            "type": "integer"
          },
          "skipped_existing": {
            "title": "Skipped Existing",
            "type": "integer"
          },
          "skipped_past": {
            "title": "Skipped Past",
            "type": "integer"
          },
          "slots": {
            "items": {
              "$ref": "#/components/schemas/SlotOut"
            },
            "title": "Slots",
            "type": "array"
          }
        },
        "required": [
          "created",
          "skipped_existing",
          "skipped_past",
          "slots"
        ],
        "title": "PublishResult",
        "type": "object"
      },
      "ResourceCreate": {
        "properties": {
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "merchant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Defaults to the caller's merchant",
            "title": "Merchant Id"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "resource_type": {
            "examples": [
              "badminton_court"
            ],
            "maxLength": 50,
            "minLength": 2,
            "pattern": "^[a-z0-9_]+$",
            "title": "Resource Type",
            "type": "string"
          },
          "timezone": {
            "default": "Asia/Singapore",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "name",
          "resource_type"
        ],
        "title": "ResourceCreate",
        "type": "object"
      },
      "ResourceOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "merchant_id": {
            "format": "uuid",
            "title": "Merchant Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "resource_id": {
            "format": "uuid",
            "title": "Resource Id",
            "type": "string"
          },
          "resource_type": {
            "title": "Resource Type",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "resource_id",
          "merchant_id",
          "name",
          "resource_type",
          "description",
          "timezone",
          "created_at"
        ],
        "title": "ResourceOut",
        "type": "object"
      },
      "SlotDetail": {
        "properties": {
          "end_time": {
            "format": "date-time",
            "title": "End Time",
            "type": "string"
          },
          "local_date": {
            "format": "date",
            "title": "Local Date",
            "type": "string"
          },
          "merchant_id": {
            "format": "uuid",
            "title": "Merchant Id",
            "type": "string"
          },
          "resource_id": {
            "format": "uuid",
            "title": "Resource Id",
            "type": "string"
          },
          "resource_name": {
            "title": "Resource Name",
            "type": "string"
          },
          "resource_type": {
            "title": "Resource Type",
            "type": "string"
          },
          "slot_id": {
            "format": "uuid",
            "title": "Slot Id",
            "type": "string"
          },
          "start_time": {
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "slot_id",
          "resource_id",
          "merchant_id",
          "start_time",
          "end_time",
          "local_date",
          "resource_name",
          "resource_type",
          "timezone"
        ],
        "title": "SlotDetail",
        "type": "object"
      },
      "SlotOut": {
        "properties": {
          "end_time": {
            "format": "date-time",
            "title": "End Time",
            "type": "string"
          },
          "local_date": {
            "format": "date",
            "title": "Local Date",
            "type": "string"
          },
          "merchant_id": {
            "format": "uuid",
            "title": "Merchant Id",
            "type": "string"
          },
          "resource_id": {
            "format": "uuid",
            "title": "Resource Id",
            "type": "string"
          },
          "slot_id": {
            "format": "uuid",
            "title": "Slot Id",
            "type": "string"
          },
          "start_time": {
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          }
        },
        "required": [
          "slot_id",
          "resource_id",
          "merchant_id",
          "start_time",
          "end_time",
          "local_date"
        ],
        "title": "SlotOut",
        "type": "object"
      },
      "SlotPublish": {
        "properties": {
          "end_hour": {
            "description": "Last slot ends at this hour, local time",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "End Hour",
            "type": "integer"
          },
          "from_date": {
            "format": "date",
            "title": "From Date",
            "type": "string"
          },
          "skip_existing": {
            "default": false,
            "description": "Publish only the hours that are still free",
            "title": "Skip Existing",
            "type": "boolean"
          },
          "start_hour": {
            "description": "First slot start, local time",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Start Hour",
            "type": "integer"
          },
          "to_date": {
            "format": "date",
            "title": "To Date",
            "type": "string"
          }
        },
        "required": [
          "from_date",
          "to_date",
          "start_hour",
          "end_hour"
        ],
        "title": "SlotPublish",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Merchant resources and publication of fixed one-hour time slots.",
    "title": "Catalogue Service",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/resources": {
      "get": {
        "operationId": "list_resources_v1_resources_get",
        "parameters": [
          {
            "in": "query",
            "name": "merchant_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Merchant Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ResourceOut"
                  },
                  "title": "Response List Resources V1 Resources Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List a merchant's resources",
        "tags": [
          "resources"
        ]
      },
      "post": {
        "operationId": "create_resource_v1_resources_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResourceCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create a bookable resource",
        "tags": [
          "resources"
        ]
      }
    },
    "/v1/resources/{resource_id}": {
      "get": {
        "operationId": "get_resource_v1_resources__resource_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "resource_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Resource Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Resource",
        "tags": [
          "resources"
        ]
      }
    },
    "/v1/resources/{resource_id}/slots": {
      "get": {
        "operationId": "list_slots_v1_resources__resource_id__slots_get",
        "parameters": [
          {
            "in": "path",
            "name": "resource_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Resource Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From Date"
            }
          },
          {
            "in": "query",
            "name": "to_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SlotOut"
                  },
                  "title": "Response List Slots V1 Resources  Resource Id  Slots Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Slots",
        "tags": [
          "resources"
        ]
      },
      "post": {
        "operationId": "publish_slots_v1_resources__resource_id__slots_post",
        "parameters": [
          {
            "in": "path",
            "name": "resource_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Resource Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SlotPublish"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Publish fixed one-hour slots that do not overlap",
        "tags": [
          "resources"
        ]
      }
    },
    "/v1/slots/{slot_id}": {
      "get": {
        "operationId": "get_slot_v1_slots__slot_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "slot_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Slot Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Slot details (used by the Booking Service)",
        "tags": [
          "slots"
        ]
      }
    }
  }
}
